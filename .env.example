# Copy to .env and adjust. Values below are local-development defaults, not real credentials.
# docker-compose.yml reads POSTGRES_* and MINIO_* from this file.

# --- Backend selection -------------------------------------------------------
# "services": Postgres + MinIO + Qdrant + OpenSearch. "local": in-memory, nothing persists.
BACKEND=services

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_USER=contextforge
POSTGRES_PASSWORD=contextforge_dev
POSTGRES_DB=contextforge
DATABASE_URL=postgresql+psycopg://contextforge:contextforge_dev@localhost:5432/contextforge

# --- MinIO (raw document archive) --------------------------------------------
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=contextforge
MINIO_SECRET_KEY=contextforge_dev_secret
MINIO_BUCKET=contextforge-raw
MINIO_SECURE=false

# --- Qdrant / OpenSearch -----------------------------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=contextforge_chunks
OPENSEARCH_URL=http://localhost:9200
OPENSEARCH_INDEX=contextforge-chunks

# --- Embeddings and reranking ------------------------------------------------
# sentence-transformers downloads the model on first use (about 90 MB for MiniLM).
# "hashing" is a deterministic offline fallback for smoke tests; it has no semantic understanding.
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
EMBEDDING_QUERY_PREFIX=
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- Chunking (sizes are in characters, roughly 4 characters per token) --------
CHUNK_STRATEGY=structure
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
CHUNK_MIN_SIZE=200

# --- Hybrid retrieval ----------------------------------------------------------
RRF_K=60
RRF_WEIGHT_BM25=1.0
RRF_WEIGHT_VECTOR=1.0
CANDIDATE_POOL=30
RERANK_CANDIDATES=20

# --- Source, tenant, access ----------------------------------------------------
TENANT_ID=halvorsen
SOURCE_NAME=local-fs
SOURCE_ROOT=datasets/sample_documents
ACCESS_POLICY_FILE=config/access_policies.yaml
USERS_FILE=config/users.yaml

# --- Optional LLM (leave empty to run without one) -------------------------------
# Ollama:  LLM_BASE_URL=http://localhost:11434/v1  LLM_MODEL=llama3.1
# OpenAI-compatible: LLM_BASE_URL=https://your-endpoint/v1  LLM_MODEL=...  LLM_API_KEY=...
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=60

# --- Evaluation, staging, logging ------------------------------------------------
EVALUATION_DATASET=datasets/evaluation/queries.json
EVALUATION_REPORT_DIR=reports/evaluation
STAGING_DIR=data/staging
LOG_LEVEL=INFO

# --- Dashboard -------------------------------------------------------------------
API_URL=http://localhost:8000
